<Project>

  <!-- Package metadata shared by everything published from this repository. Kept here rather than repeated in each
       csproj: a licence or repository URL that drifts between packages is worse than none, because whichever one a
       consumer happens to read, they have no way to tell it is the stale one. -->
  <PropertyGroup>
    <Authors>Denis Zaporozhets</Authors>
    <Company>Denis Zaporozhets</Company>
    <Copyright>Copyright 2019-2026 Denis Zaporozhets</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/QuantumDeveloper/AdamantiumVulkan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/QuantumDeveloper/AdamantiumVulkan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- Off by default, on per project. Demos, sandboxes and the binding generator are not products, and a package
       published by accident cannot be taken back - nuget.org lets a version be unlisted, never deleted. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Content goes to contentFiles only. By default the SDK also copies it to content\, which packages.config-era
       projects read - so every native library shipped here travelled twice and the Slang package was 28.5 MB against
       14.3 MB for the same payload. Nothing reads content\ any more: PackageReference uses contentFiles, and the
       loader in this repository looks there first and at content\ only as a fallback. -->
  <PropertyGroup>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
  </PropertyGroup>

  <!-- No condition on IsPackable here or below. MSBuild finishes evaluating PROPERTIES before it starts on ITEMS, and
       this file is imported before the project body - so a PropertyGroup guarded on IsPackable reads the false set
       above, never the true the project sets later, while an ItemGroup guarded the same way reads the final value.
       That split is how PackageIcon silently failed to appear while icon.png was packed anyway. A project that does
       not pack ignores these properties regardless, so the guard bought nothing. -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Each package carries its OWN icon.png, taken from beside its csproj, because one icon for the whole repository
       cannot say which package you are looking at. They share a mark and a colour and differ by a code band; the set
       is generated by build/make-icons.ps1, which is also where the reasoning is written down.
       Both halves are guarded on the file existing: PackageIcon pointing at a file that is not packed is NU5046, a
       build broken by a missing picture. PackageIconUrl is not used - nuget.org deprecated it, and the image has to
       travel inside the package. -->
  <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\icon.png')">
    <None Include="$(MSBuildProjectDirectory)\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
