<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <LangVersion>latestmajor</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AdamantiumVulkan.Slang</AssemblyName>
    <RootNamespace>AdamantiumVulkan.Slang</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>AdamantiumVulkan.Slang</PackageId>
    <Version>1.0.2</Version>
    <Authors>Den</Authors>
    <Company>Adamantium studio</Company>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!--
    Native libraries are produced by native/build.ps1 (Windows) or native/build.sh (Linux/macOS), which
    stage the slang-c-shared shim and the Slang runtime here. The Exists(...) conditions let the project
    build even before the scripts have run; the C# interop itself is generated by QuantumBinding from
    native/slang_c.h into Generated/ (added separately).
  -->
  <ItemGroup>
    <Content Include="slang-c-shared.dll" Condition="Exists('slang-c-shared.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="slang.dll" Condition="Exists('slang.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="libslang-c-shared.so" Condition="Exists('libslang-c-shared.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="libslang-c-shared.dylib" Condition="Exists('libslang-c-shared.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="libslang.so" Condition="Exists('libslang.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
    <Content Include="libslang.dylib" Condition="Exists('libslang.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <PackageCopyToOutput>true</PackageCopyToOutput>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\QuantumBinding\QuantumBinding.Utils\QuantumBinding.Utils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

</Project>
